// Предопределенная процедура проведения документа
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Указываем, что движения по регистру будут записаны
	Движения.ОстаткиКомплектующих.Записывать = Истина;
	
	// 2. Сворачиваем дубли в оперативной памяти (Номенклатура -> Сумма количества)
	ТаблицаКомплектующих = Комплектующие.Выгрузить();
	ТаблицаКомплектующих.Свернуть("Номенклатура", "Количество");
	
	// 3. Формируем запрос для проверки остатков
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Док.Номенклатура КАК Номенклатура,
		|	Док.Количество КАК Требуется
		|ПОМЕСТИТЬ ВТ_Требуется
		|ИЗ
		|	&ТаблицаКомплектующих КАК Док
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	ВТ.Требуется КАК Требуется,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ВНаличии
		|ИЗ
		|	ВТ_Требуется КАК ВТ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиКомплектующих.Остатки(
		|		&МоментВремени,
		|		Склад = &Склад И Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТ_Требуется)
		|	) КАК Остатки
		|	ПО ВТ.Номенклатура = Остатки.Номенклатура";
	
	// Передаем параметры в запрос
	Запрос.УстановитьПараметр("ТаблицаКомплектующих", ТаблицаКомплектующих);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	// Выполняем выборку
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Проверка: хватает ли товара на складе?
		Если Выборка.ВНаличии < Выборка.Требуется Тогда
			Отказ = Истина;
			Нехватка = Выборка.Требуется - Выборка.ВНаличии;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно товара ""%1"" на складе: требуется %2, в наличии %3 (не хватает %4)!",
				Выборка.НоменклатураНаименование, 
				Выборка.Требуется, 
				Выборка.ВНаличии, 
				Нехватка
			);
			Сообщение.Сообщить();
		КонецЕсли;
		
		// Если по всем позициям товара хватает — формируем движение расхода
		Если НЕ Отказ Тогда
			Движение = Движения.ОстаткиКомплектующих.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Склад = Склад;
			Движение.Номенклатура = Выборка.Номенклатура;
			Движение.Количество = Выборка.Требуется;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняем текущую дату и время при создании нового документа
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Дата = ТекущаяДата();
КонецПроцедуры