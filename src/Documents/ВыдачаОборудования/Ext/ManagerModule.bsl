
Процедура ПечатьАкта(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(ПечатьАкта)
	Макет = Документы.ВыдачаОборудования.ПолучитьМакет("ПечатьАкта");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыдачаОборудования.Дата,
	|	ВыдачаОборудования.Комментарий,
	|	ВыдачаОборудования.Номер,
	|	ВыдачаОборудования.Сотрудник,
	|	ВыдачаОборудования.СписокОборудования.(
	|		Оборудование,
	|		Примечание
	|	)
	|ИЗ
	|	Документ.ВыдачаОборудования КАК ВыдачаОборудования
	|ГДЕ
	|	ВыдачаОборудования.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСписокОборудованияШапка = Макет.ПолучитьОбласть("СписокОборудованияШапка");
	ОбластьСписокОборудования = Макет.ПолучитьОбласть("СписокОборудования");
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьСписокОборудованияШапка);
		ВыборкаСписокОборудования = Выборка.СписокОборудования.Выбрать();
		Пока ВыборкаСписокОборудования.Следующий() Цикл
			ОбластьСписокОборудования.Параметры.Заполнить(ВыборкаСписокОборудования);
			ТабДок.Вывести(ОбластьСписокОборудования, ВыборкаСписокОборудования.Уровень());
		КонецЦикла;

		Подвал.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры
