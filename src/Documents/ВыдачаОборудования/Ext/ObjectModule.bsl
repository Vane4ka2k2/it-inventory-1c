// Переопределенная процедура платформы: вызывается перед записью/проведением документа
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// 1. Проверяем, выбран ли сотрудник
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан сотрудник, которому выдаётся техника!";
		Сообщение.Поле = "Сотрудник";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
	// 2. Проверяем, что табличная часть не пустая
	Если СписокОборудования.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В документе нет ни одной строки оборудования для выдачи!";
		Сообщение.Поле = "СписокОборудования";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
	// 3. Проверка на дубли (нельзя выдавать один и тот же ноутбук дважды в одном документе)
	ТаблицаПроверки = СписокОборудования.Выгрузить();
	ТаблицаПроверки.Свернуть("Оборудование");
	
	Если ТаблицаПроверки.Количество() <> СписокОборудования.Количество() Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В таблице оборудования обнаружены повторяющиеся устройства!";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр СостояниеОборудования
	Движения.СостояниеОборудования.Записывать = Истина;
	Для Каждого ТекСтрокаСписокОборудования Из СписокОборудования Цикл
		Движение = Движения.СостояниеОборудования.Добавить();
		Движение.Период = Дата;
		Движение.Оборудование = ТекСтрокаСписокОборудования.Оборудование;
		Движение.Сотрудник = Сотрудник;
		Движение.Состояние = Перечисления.СостоянияОборудования.ВЭксплуатации;
	КонецЦикла;

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры
