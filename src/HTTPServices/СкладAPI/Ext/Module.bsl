// =============================================================================
// ЭНДПОИНТ 1: GET /warehouse/api/v1/balance
// Возвращает актуальные остатки товаров на складах в формате JSON
// =============================================================================
Функция ОстаткиПолучитьОстатки(Запрос)
	
	// 1. Делаем запрос к реальным остаткам регистра накопления
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Остатки.Склад.Наименование КАК Склад,
		|	Остатки.Номенклатура.Наименование КАК Товар,
		|	Остатки.Номенклатура.Артикул КАК Артикул,
		|	Остатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиКомплектующих.Остатки КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	Товар";
	
	ЗапросКБД = Новый Запрос(ТекстЗапроса);
	Выборка = ЗапросКБД.Выполнить().Выбрать();
	
	// 2. Формируем массив структур для сериализации в JSON
	СписокОстатков = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("warehouse", Выборка.Склад);
		Строка.Вставить("item",      Выборка.Товар);
		Строка.Вставить("sku",       Выборка.Артикул);
		Строка.Вставить("quantity",  Выборка.Количество);
		СписокОстатков.Добавить(Строка);
	КонецЦикла;
	
	// 3. Сериализуем данные в строку JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СписокОстатков);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// 4. Формируем ответ 200 OK
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции


// =============================================================================
// ЭНДПОИНТ 2: POST /warehouse/api/v1/issue
// Принимает JSON с заявкой на списание и автоматически создает документ
// =============================================================================
Функция СписаниеСоздатьСписание(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(201);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Читаем входящее тело запроса
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"": ""Тело запроса пустое""}");
		Возврат Ответ;
	КонецЕсли;
	
	// 2. Десериализуем JSON
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ВходящиеДанные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"": ""Некорректный формат JSON""}");
		Возврат Ответ;
	КонецПопытки;
	
	// 3. Создаем документ «СписаниеКомплектующих» программно
	Попытка
		Док = Документы.СписаниеКомплектующих.СоздатьДокумент();
		Док.Заполнить(Неопределено); // Заполнит текущую дату через ОбработкаЗаполнения
		
		// Ищем склад и сотрудника по названиям из JSON
		Док.Склад     = Справочники.Склады.НайтиПоНаименованию(ВходящиеДанные.warehouse);
		Док.Сотрудник = Справочники.Сотрудники.НайтиПоНаименованию(ВходящиеДанные.employee);
		
		Если НЕ ЗначениеЗаполнено(Док.Склад) Тогда
			ВызватьИсключение СтрШаблон("Склад ""%1"" не найден в базе!", ВходящиеДанные.warehouse);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Док.Сотрудник) Тогда
			ВызватьИсключение СтрШаблон("Сотрудник ""%1"" не найден в базе!", ВходящиеДанные.employee);
		КонецЕсли;
		
		// Заполняем табличную часть товарами
		Для Каждого Позиция Из ВходящиеДанные.items Цикл
			ТоварСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Позиция.name);
			Если НЕ ЗначениеЗаполнено(ТоварСсылка) Тогда
				ВызватьИсключение СтрШаблон("Товар ""%1"" не найден!", Позиция.name);
			КонецЕсли;
			
			НоваяСтрока = Док.Комплектующие.Добавить();
			НоваяСтрока.Номенклатура = ТоварСсылка;
			НоваяСтрока.Количество   = Позиция.quantity;
		КонецЦикла;
		
		// 4. Проводим документ (здесь сработает наш контроль остатков!)
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		// Успешный ответ 201 Created
		Результат = Новый Структура;
		Результат.Вставить("status", "success");
		Результат.Вставить("document_number", Док.Номер);
		Результат.Вставить("message", "Документ списания успешно создан и проведен!");
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		
	Исключение
		// Ошибка валидации или нехватки остатков: отдаем 400 Bad Request
		Ответ.КодСостояния = 400;
		Результат = Новый Структура("status,error", "fail", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции