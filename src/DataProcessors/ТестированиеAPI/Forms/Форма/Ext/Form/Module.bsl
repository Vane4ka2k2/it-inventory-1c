&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Подставляем готовый шаблон JSON, чтобы не вбивать его руками при каждом тесте
	Если ПустаяСтрока(ВходящийJSON) Тогда
		ВходящийJSON = 
		"{" + Символы.ПС +
		"  ""warehouse"": ""Основной склад""," + Символы.ПС +
		"  ""employee"": ""Иванов Иван Иванович""," + Символы.ПС +
		"  ""items"": [" + Символы.ПС +
		"    {" + Символы.ПС +
		"      ""name"": ""SSD Kingston NV2 1TB""," + Символы.ПС +
		"      ""quantity"": 1" + Символы.ПС +
		"    }" + Символы.ПС +
		"  ]" + Символы.ПС +
		"}";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОстаткиGET(Команда)
	ОтветСервера = ЗапроситьОстаткиНаСервере();
КонецПроцедуры

&НаСервере
Функция ЗапроситьОстаткиНаСервере()
	
	ЗапросКБД = Новый Запрос(
		"ВЫБРАТЬ
		|	Остатки.Склад.Наименование КАК warehouse,
		|	Остатки.Номенклатура.Наименование КАК item,
		|	Остатки.Номенклатура.Артикул КАК sku,
		|	Остатки.КоличествоОстаток КАК quantity
		|ИЗ
		|	РегистрНакопления.ОстаткиКомплектующих.Остатки КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	warehouse,
		|	item");
		
	Выборка = ЗапросКБД.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура("warehouse,item,sku,quantity", 
			Выборка.warehouse, Выборка.item, Выборка.sku, Выборка.quantity);
		Список.Добавить(Стр);
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто));
	ЗаписатьJSON(ЗаписьJSON, Список);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаКлиенте
Процедура ОтправитьЗаявкуPOST(Команда)
	ОтветСервера = ОтправитьЗаявкуНаСервере(ВходящийJSON);
КонецПроцедуры

&НаСервере
Функция ОтправитьЗаявкуНаСервере(СтрокаJSON)
	
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат "HTTP 400 Bad Request: Тело запроса пустое!";
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		// 1. Создаем документ
		Док = Документы.СписаниеКомплектующих.СоздатьДокумент();
		Док.Заполнить(Неопределено);
		
		// 2. Валидация сущностей
		Док.Склад = Справочники.Склады.НайтиПоНаименованию(Данные.warehouse);
		Если НЕ ЗначениеЗаполнено(Док.Склад) Тогда
			ВызватьИсключение СтрШаблон("Склад ""%1"" не найден в базе!", Данные.warehouse);
		КонецЕсли;
		
		Док.Сотрудник = Справочники.Сотрудники.НайтиПоНаименованию(Данные.employee);
		Если НЕ ЗначениеЗаполнено(Док.Сотрудник) Тогда
			ВызватьИсключение СтрШаблон("Сотрудник ""%1"" не найден в базе!", Данные.employee);
		КонецЕсли;
		
		// 3. Заполнение табличной части
		Для Каждого Поз Из Данные.items Цикл
			ТоварСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Поз.name);
			Если НЕ ЗначениеЗаполнено(ТоварСсылка) Тогда
				ВызватьИсключение СтрШаблон("Номенклатура ""%1"" не найдена в базе!", Поз.name);
			КонецЕсли;
			
			НоваяСтрока = Док.Комплектующие.Добавить();
			НоваяСтрока.Номенклатура = ТоварСсылка;
			НоваяСтрока.Количество   = Поз.quantity;
		КонецЦикла;
		
		// 4. Проведение (контроль остатков и управляемые блокировки)
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат СтрШаблон("HTTP 201 Created! Успешно создан и проведён документ №%1 от %2", Док.Номер, Формат(Док.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"));
		
	Исключение
		// Перехватываем точный текст нехватки из очереди сообщений пользователя
		ТекстыОшибок = Новый Массив;
		Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл
			ТекстыОшибок.Добавить(Сообщ.Текст);
		КонецЦикла;
		
		Если ТекстыОшибок.Количество() > 0 Тогда
			ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС);
		Иначе
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		
		Возврат СтрШаблон("HTTP 400 Bad Request!" + Символы.ПС + "Причина: %1", ТекстОшибки);
	КонецПопытки;
	
КонецФункции